# Database Configuration
POSTGRES_USER=grocer
POSTGRES_PASSWORD=grocerpassword
POSTGRES_DB=grocer_db
DATABASE_URL=postgresql://grocer:grocerpassword@db/grocer_db

# Security
# Generate a secure random string for production
SECRET_KEY=change_this_to_a_secure_random_string_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Gemini AI API Key
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Ports
VITE_PORT=5173

# Docker Host Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Home Assistant Notification Configuration
HA_BASE_URL=http://homeassistant.local:8123
HA_WEBHOOK_ID=your_webhook_id_here
