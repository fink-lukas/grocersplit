# Database Configuration
POSTGRES_USER=grocer
POSTGRES_PASSWORD=grocerpassword
POSTGRES_DB=grocer_db
DATABASE_URL=postgresql://grocer:grocerpassword@db/grocer_db

# Security
# Generate a secure random string for production
SECRET_KEY=change_this_to_a_secure_random_string_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Gemini AI API Configuration (Direct SDK or OpenAI-compatible Gateway)
# Option A: Direct Gemini SDK (key cycling supported with comma separation)
# GEMINI_API_KEY="your_gemini_api_key_here,your_next_key"

# Option B: OpenAI-compatible API Gateway (e.g. new-api, One API)
# Since backend runs in Docker, use http://host.docker.internal:<port>/v1 if new-api is running on your Mac host
NEW_API_BASE_URL=http://host.docker.internal:3000/v1
NEW_API_KEY=your_new_api_key_here
NEW_API_MODEL=gemini-2.5-flash

# Frontend Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173


# Home Assistant Notification Configuration
HA_BASE_URL=http://homeassistant.local:8123
HA_WEBHOOK_ID=your_webhook_id_here

